# Day14 — environment variables
# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — never commit it.
# Also paste these into Vercel → day14-studio → Settings → Environment Variables.

# ============================================================
# Supabase — day14-studio project (created 2026-05-16)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://grpfffwzzwxhivjpokev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only if you connect via Postgres directly (not through PostgREST)
DATABASE_URL=

# ============================================================
# Anthropic — chatbot + agent inference
# ============================================================
ANTHROPIC_API_KEY=
# Optional. /api/chat uses this model. Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=

# ============================================================
# Stripe — test mode first, flip to live when ready
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENT_LINK_SITE=https://buy.stripe.com/test_...
STRIPE_PAYMENT_LINK_PORTAL=https://buy.stripe.com/test_...
STRIPE_PAYMENT_LINK_PLATFORM=https://buy.stripe.com/test_...

# ============================================================
# Resend — transactional email + inbound classifier
# ============================================================
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=hello@day14.us

# ============================================================
# Cal.com — discovery call booking
# ============================================================
CAL_BOOKING_URL=https://cal.com/jacksbot147/30min
CAL_WEBHOOK_SECRET=

# ============================================================
# Vercel — for build-agent to create new projects per customer
# ============================================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ============================================================
# GitHub — for build-agent to fork templates
# ============================================================
GITHUB_TOKEN=
GITHUB_USERNAME=jacksbot147-code

# ============================================================
# Day14 OS — internal config
# ============================================================
NEXT_PUBLIC_SITE_URL=https://day14.us
DAY14_OPERATOR_EMAIL=jacksbot147@gmail.com
DAY14_ENV=development

# ============================================================
# Not required by the public site. Safe to delete in Vercel; leftover
# readers no-op when the variable is unset:
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   PRINTIFY_API_KEY
#   MAILERLITE_API_KEY, MAILERLITE_DAY14_OS_GROUP_ID, MAILERLITE_DEFAULT_GROUP_ID
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER, TWILIO_OPERATOR_NUMBER
